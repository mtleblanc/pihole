# Copy to secrets.env (gitignored) and fill in, or leave blank and
# install.sh will prompt for each value.

# NordVPN *service credentials* (not your account email/password).
# Get them at: https://my.nordaccount.com -> NordVPN -> Manual setup
NORD_USER=""
NORD_PASS=""

# Password for the Samba share (user = PI_USER).
SMB_PASS=""

# Pi-hole web admin password.
PIHOLE_WEB_PASS=""

# Transmission web UI password. Leave empty for no auth (old setup had none).
TRANSMISSION_RPC_USER="transmission"
TRANSMISSION_RPC_PASS=""
