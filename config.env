# Site configuration (non-secret). Sourced by install.sh.
# Credentials live in secrets.env (gitignored) - see secrets.env.example.

# --- System -------------------------------------------------------------
# Login user created by Raspberry Pi Imager. Defaults to whoever runs sudo.
PI_USER="${PI_USER:-${SUDO_USER:-pi}}"
TIMEZONE="Europe/London"

# --- Network ------------------------------------------------------------
# Pi-hole needs a fixed address; the router's DHCP hands this out as DNS.
LAN_IFACE="eth0"
STATIC_IP="192.168.1.80/24"
GATEWAY="192.168.1.1"

# --- External drive -----------------------------------------------------
# Find with: lsblk -f   (the UUID of the partition, not the disk)
DRIVE_UUID="278f721f-7218-47e6-a90f-343cf1562a02"
DRIVE_FSTYPE="ext4"
MOUNT_POINT="/srv/media"
# Group shared by the login user, transmission and samba for file access.
MEDIA_GROUP="media"

# --- Samba --------------------------------------------------------------
SMB_SHARE_NAME="MyMedia"

# --- Transmission -------------------------------------------------------
# Relative to MOUNT_POINT. Empty = drive root (matches the old setup).
TRANSMISSION_DOWNLOAD_SUBDIR=""
TRANSMISSION_PEER_PORT=51413

# --- NordVPN ------------------------------------------------------------
# Optional 2-letter country code to restrict server choice (e.g. CA, GB, US).
# Empty = Nord's recommended (nearest, least-loaded) server.
NORD_COUNTRY=""
# Policy-routing table number used for transmission's traffic.
VPN_ROUTE_TABLE=100

# --- Pi-hole ------------------------------------------------------------
PIHOLE_UPSTREAMS='["8.8.8.8", "8.8.4.4"]'
# Old box had blocking disabled (BLOCKING_ENABLED=false). Set false to match.
PIHOLE_BLOCKING_ENABLED=true
